{
  "name": "postbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant email service: localized templates, per-template senders, pluggable delivery connections.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed": "tsx scripts/seed.ts",
    "tenant": "tsx scripts/create-tenant.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "handlebars": "^4.7.10",
    "hono": "^4.13.14",
    "mjml": "^5.4.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mjml": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
