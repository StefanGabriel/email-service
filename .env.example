# Postgres connection string
DATABASE_URL=postgresql://postbox:postbox@localhost:5432/postbox
# 32 random bytes, base64: openssl rand -base64 32
POSTBOX_SECRET_KEY=
# Optional
# PORT=8080
# WORKER_INTERVAL_MS=2000
# MAX_ATTEMPTS=6
# WORKER_DISABLED=1
# Only for docker-compose --profile tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
